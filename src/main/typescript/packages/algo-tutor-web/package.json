    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "storybook": "^10.6.5",
