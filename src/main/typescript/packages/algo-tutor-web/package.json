{
  "name": "algo-tutor-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type:check": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "storybook:dev": "storybook dev -p 6008",
    "storybook:build": "storybook build",
    "api:types": "openapi-typescript src/api/schema.json --default-non-nullable false -o src/api/schema.gen.ts && prettier --write src/api/schema.gen.ts"
  },
  "dependencies": {
