{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "type:check": {
      "dependsOn": ["^build"]
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    // Not cached: `lint` matches jack06215/monorepo, where a package's `lint`
    // runs `eslint --fix`. `format` rewrites source files in every package.
    "lint": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    // Vite's dev server and Storybook's, for the frontend packages.
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
