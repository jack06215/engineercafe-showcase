load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("//rules/markdown:defs.bzl", "markdown_docs")

# .markdownlint.jsonc is data for the //rules/markdown lint targets, and
# pyproject.toml (ruff and mypy settings) for the //rules/python/lint ones.
exports_files(
    srcs = [
        ".markdownlint.jsonc",
        "pyproject.toml",
    ],
)

markdown_docs(
    name = "docs",
    srcs = glob(["*.md"]),
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = [
        "./.git/*",
    ],
    lint_mode = "warn",
    mode = "diff",
)

buildifier(
    name = "buildifier.fix",
    exclude_patterns = [
        "./.git/*",
    ],
    lint_mode = "fix",
    mode = "fix",
)
