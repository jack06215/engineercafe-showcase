load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rules/markdown:defs.bzl", "markdown_docs")
load(":defs.bzl", "py_library")
load(":lint_runfiles_test.bzl", "lint_runfiles_test")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "ruff_bin_extract",
    srcs = ["@monorepo_pip//ruff:whl"],
    outs = ["ruff_bin"],
    cmd = "unzip -p $(execpath @monorepo_pip//ruff:whl) 'ruff-*.data/scripts/ruff' > $@ && chmod +x $@",
    executable = True,
)

native_binary(
    name = "ruff",
    src = ":ruff_bin_extract",
    out = "ruff_bin_out",
)

py_console_script_binary(
    name = "mypy",
    legacy_create_init = False,
    pkg = "@monorepo_pip//mypy",
)

exports_files([
    "check_all.sh",
    "fix.sh",
    "fix_all.sh",
    "lint.sh",
])

markdown_docs(
    name = "docs",
    srcs = glob(["*.md"]),
)

sh_test(
    name = "lint_config_test",
    srcs = ["lint_config_test.sh"],
    args = [
        "$(rootpath lint.sh)",
        "$(rootpath :ruff)",
        "$(rootpath :mypy)",
        "$(rootpath //:pyproject.toml)",
        "$(rootpath testdata/undocumented.py)",
    ],
    data = [
        "lint.sh",
        "testdata/undocumented.py",
        ":mypy",
        ":ruff",
        "//:pyproject.toml",
    ],
)

py_library(
    name = "documented",
    srcs = ["testdata/documented.py"],
)

lint_runfiles_test(
    name = "lint_runfiles_test",
    target_under_test = ":documented.lint",
)
