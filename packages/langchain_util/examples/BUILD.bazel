load("@monorepo_pip//:requirements.bzl", "requirement")
load("//rules/python/lint:defs.bzl", "py_binary")

# The prompts are read at runtime from next to the script, so every example
# needs its `.jinja` files in the runfiles tree.
_PROMPTS = glob(["prompts/**/*.jinja"])

py_binary(
    name = "string_output",
    srcs = ["string_output.py"],
    data = _PROMPTS,
    main = "string_output.py",
    deps = [
        "//packages/common",
        "//packages/langchain_util",
        requirement("langchain-core"),
    ],
)

py_binary(
    name = "pydantic_output",
    srcs = ["pydantic_output.py"],
    data = _PROMPTS,
    main = "pydantic_output.py",
    deps = [
        "//packages/common",
        "//packages/langchain_util",
        requirement("langchain-core"),
        requirement("pydantic"),
    ],
)

py_binary(
