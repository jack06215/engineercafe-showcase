load("@monorepo_pip//:requirements.bzl", "requirement")
load("@rules_python//python:py_test.bzl", "py_test")
load("//rules/markdown:defs.bzl", "markdown_docs")
load("//rules/python/lint:defs.bzl", "py_binary", "py_library")
load("//rules/python/streamlit:defs.bzl", "streamlit_app")

# The chart format and its checks, with no LLM or UI behind them, so the Claude
# workshop's chart agent can check charts without LangGraph, Ollama or Streamlit.
py_library(
    name = "chart_core",
    srcs = [
        "chart_spec.py",
        "checks.py",
        "compiler.py",
        "csv_loader.py",
        "profile.py",
    ],
    visibility = ["//packages/vega_lite_ai:__pkg__"],
    deps = [
        # Only for the Vega-Lite JSON schema it ships.
        requirement("altair"),
        requirement("jsonschema"),
        requirement("pandas"),
        requirement("pydantic"),
        requirement("pyyaml"),
    ],
)

# Everything but main.py and the tests. The YAML files and the sample CSVs are
# read from next to the code at runtime.
py_library(
    name = "vega_lite_chat_lib",
    srcs = [
        "agent.py",
        "config.py",
        "llm.py",
        "prompts.py",
        "samples.py",
        "session.py",
        "translator.py",
        "ui.py",
    ],
    data = [
        "config.yaml",
        "prompts.yaml",
    ] + glob(["sample_data/*.csv"]),
    deps = [
        ":chart_core",
        "//packages/langchain_util",
        requirement("httpx"),
        requirement("langchain-core"),
        requirement("langchain-ollama"),
        requirement("langgraph"),
        requirement("ollama"),
        requirement("pandas"),
        requirement("pydantic"),
        requirement("pyyaml"),
        requirement("streamlit"),
    ],
)

# streamlit_app hands its `app` file over as data, which the lint macro never
# sees, so main.py only calls ui.render_app().
streamlit_app(
    name = "vega_lite_chat",
    app = "main.py",
    deps = [":vega_lite_chat_lib"],
)

# Runs the eval cases against the real Ollama. Run by hand before a demo; it is
# a binary so `bazel test //...` never needs Ollama.
py_binary(
    name = "live_eval",
    srcs = ["live_eval.py"],
    data = ["eval_cases.yaml"],
    main = "live_eval.py",
    deps = [":vega_lite_chat_lib"],
)

# Regenerates the synthetic sample CSVs (fixed seed). The weather CSV comes
# from JMA and is not generated.
py_binary(
    name = "make_samples",
    srcs = ["make_samples.py"],
    main = "make_samples.py",
    deps = [requirement("pandas")],
)

# Scripted stand-ins for the translator's model and the chat model.
py_library(
    name = "fake_models",
    testonly = True,
    srcs = ["fake_models.py"],
    deps = [
        ":vega_lite_chat_lib",
        requirement("langchain-core"),
        requirement("pydantic"),
    ],
)

_TESTS = [
    "test_agent",
    "test_checks",
    "test_compiler",
    "test_config",
    "test_csv_loader",
    "test_profile",
    "test_prompts",
    "test_session",
    "test_translator",
]

[
    py_test(
        name = name,
        srcs = [name + ".py"],
        legacy_create_init = False,
        main = name + ".py",
        deps = [
            ":fake_models",
            ":vega_lite_chat_lib",
        ],
    )
    for name in _TESTS
]

# Drives the app headlessly through streamlit.testing's AppTest, which runs
# main.py from next to the test in the runfiles.
py_test(
    name = "test_ui",
    srcs = ["test_ui.py"],
    data = ["main.py"],
    legacy_create_init = False,
    main = "test_ui.py",
    deps = [
        ":fake_models",
        ":vega_lite_chat_lib",
    ],
)

test_suite(
    name = "test_all",
    tests = _TESTS + ["test_ui"],
)

markdown_docs(
    name = "docs",
    srcs = glob(["*.md"]),
    config = ".markdownlint.jsonc",
)
